# ===============================================================================
# NEXUS Core Banking AI — Environment Configuration
# ===============================================================================

# Host and Port
HOST=127.0.0.1
PORT=8000

# AI Provider: 'cognitive' (Offline/Zero-Key default), 'gemini', or 'openai'
LLM_PROVIDER=cognitive

# Optional: Google Gemini API Key (if using live Gemini models)
GEMINI_API_KEY=

# Optional: OpenAI API Key (if using live OpenAI models)
OPENAI_API_KEY=

# AI Gateway Guardrail Controls
ENABLE_GUARDRAILS=true
ENABLE_PII_MASKING=true
TOKEN_BUDGET_PER_REQUEST=4096
